// Cosplay Build Planner data model.
// Money is stored as integer minor units ("cents") plus an ISO 4217 currency
// code. A null currency inherits: part/item → project → app base currency.
// Status/category values are validated by Zod (src/lib/constants.ts) because
// SQLite has no native enums.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id             String    @id @default(cuid())
  /// Owner. Null only for projects created before accounts existed ("unclaimed"):
  /// those are visible to nobody until assigned with scripts/claim-projects.
  ownerId        String?
  characterName  String
  series         String?
  conventionName String?
  startDate      DateTime?
  deadline       DateTime?
  /// idea | researching | building | finished
  status         String    @default("idea")
  /// Currency for budget, manual spent and the project's totals; null = base currency
  currency       String?
  budgetCents    Int?
  /// Unused since multi-currency (totals are always calculated from paid parts); kept for old data.
  spentCents     Int?
  notes          String?
  /// Attribution when copied from a Community project (public info only)
  copiedFromPublicationId String?
  copiedFromTitle         String?
  copiedFromCreator       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?
  deletedAt      DateTime?

  owner         User?              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  publication   Publication?
  moderation    ModerationAction[]
  parts         BuildPart[]
  references    ReferenceImage[]
  shoppingItems ShoppingListItem[]

  @@index([ownerId, deletedAt, archivedAt])
  @@index([deletedAt, archivedAt])
}

model BuildPart {
  id                 String    @id @default(cuid())
  /// Stable expense ID used by export/import (unique within a project)
  uid                String    @default(cuid())
  projectId          String
  name               String
  category           String    @default("other")
  /// needed | ordered | arrived | building | done
  status             String    @default("needed")
  /// Currency of both costs below; null = the project's currency
  currency           String?
  /// Per-item costs; line totals multiply by quantity.
  estimatedCostCents Int?
  actualCostCents    Int?
  quantity           Int       @default(1)
  supplier           String?
  url                String?
  notes              String?
  completedAt        DateTime?
  /// Manual order in the parts list (ascending)
  position           Int       @default(0)

  /// Payment: set once the part is paid and never re-converted at today's rate.
  /// paidBaseCents is the line total (actual × quantity) in the project's base currency.
  paidAt             DateTime?
  paidBaseCents      Int?
  /// base = original × fxRate; for manual entries the implied rate
  fxRate             Float?
  /// Date the rate applies to (may be the previous business day of paidAt)
  fxRateDate         String?
  fxSource           String?
  /// true when the base amount was typed in (bank/PayPal charge), not looked up
  fxManual           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shoppingItem ShoppingListItem?
  images       ReferenceImage[]

  @@unique([projectId, uid])
  @@index([projectId, deletedAt])
}

/// Every private image of a project: references, photos of one part, and the
/// project's main picture. All are served by the same owner-checked route.
model ReferenceImage {
  id           String   @id @default(cuid())
  projectId    String
  /// reference | part | cover (one cover per project) | progress (timeline photo)
  kind         String   @default("reference")
  /// Set for kind "part"
  partId       String?
  /// Free-text group used to organise references (e.g. "Armour", "Wig")
  groupName    String?
  /// Manual order (ascending) within the same kind / part
  position     Int      @default(0)
  /// Progress photos: the day the photo shows (defaults to the upload day) and an optional stage label
  takenAt      DateTime?
  stage        String?
  /// Paths relative to UPLOAD_DIR
  filePath     String
  thumbPath    String
  originalName String
  mimeType     String
  sizeBytes    Int
  /// Guest images are stored encrypted (AES-256-GCM) with a key that only the
  /// guest's browser holds, so they can't be opened from the server's disk.
  encrypted    Boolean  @default(false)
  width        Int?
  height       Int?
  caption      String?
  sourceUrl    String?
  createdAt    DateTime @default(now())

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  part    BuildPart? @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([projectId, kind, position])
  @@index([partId])
}

model ShoppingListItem {
  id                 String    @id @default(cuid())
  /// Owner (also set for project items). Null = created before accounts existed.
  ownerId            String?
  /// Stable ID used by export/import (unique within a project)
  uid                String    @default(cuid())
  /// Null for general items not tied to a project
  projectId          String?
  /// Set when the item is generated from a part that is still "needed"
  partId             String?   @unique
  name               String
  category           String    @default("other")
  supplier           String?
  url                String?
  quantity           Int       @default(1)
  /// null = the project's currency (or the base currency for general items)
  currency           String?
  estimatedCostCents Int?
  notes              String?
  purchased          Boolean   @default(false)
  purchasedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  owner   User?      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  project Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  part    BuildPart? @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@unique([projectId, uid])
  @@index([ownerId, deletedAt])
  @@index([deletedAt, purchased])
}

/// App-wide settings (e.g. baseCurrency).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Cached exchange rates: 1 EUR = ratePerEur units of currency.
model ExchangeRate {
  currency   String   @id
  ratePerEur Float
  /// Provider name and the date the provider says the rate is for
  source     String
  rateDate   String
  fetchedAt  DateTime
}

// ---------------------------------------------------------------------------
// Accounts (Better Auth). Field names follow Better Auth's schema; extra
// columns (defaultCurrency) are ours and ignored by the library.

model User {
  id              String    @id
  /// Public display name
  name            String
  /// Private: never shown publicly or included in exports
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  /// Base currency for new projects and shopping-list totals
  defaultCurrency String?
  /// "user" or "admin". Admins can remove Community publications. Only set
  /// with the set-admin command on the server, never through the app.
  role            String    @default("user")
  /// Guest ("try without an account"): no email/password, private only, can't
  /// publish, deleted 30 days after creation unless they register (which moves
  /// their data into the new account). Managed by Better Auth's anonymous plugin.
  isAnonymous     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  projects      Project[]
  shoppingItems ShoppingListItem[]
  publications  Publication[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Password hash (scrypt, managed by Better Auth)
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Fixed-window counters for login/registration/reset rate limiting.
model AuthRateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

// ---------------------------------------------------------------------------
// Community. A publication is a SNAPSHOT of public data, built from an
// allow-list when the owner publishes or presses "Update published version".
// Private edits never reach it automatically. Unpublishing deletes the row,
// its PublicImage rows and the copied files.

model Publication {
  id            String   @id @default(cuid())
  projectId     String   @unique
  ownerId       String
  title         String
  series        String?
  /// Public text written for the community (never copied from private notes)
  description   String?
  /// JSON array of lowercase tags
  tags          String   @default("[]")
  includeBudget Boolean  @default(false)
  includeCosts  Boolean  @default(false)
  includeLinks  Boolean  @default(false)
  /// Last built public representation (informational since 1.6: public pages
  /// are built live from the project; see src/lib/community/view.ts)
  snapshot      String
  /// all = main picture + every reference image (new ones appear automatically);
  /// selected = only the ids in selectedImageIds
  imageMode        String  @default("all")
  /// JSON array of ReferenceImage ids (cover/reference kinds) for "selected"
  selectedImageIds String  @default("[]")
  /// Show the progress-photo timeline publicly (off unless the owner ticks it)
  includeProgress  Boolean @default(false)
  /// Before 1.6: PublicImage copy used as cover. Unused now.
  coverImageId  String?
  version       Int      @default(1)
  publishedAt   DateTime @default(now())
  /// When the published version was last replaced
  versionAt     DateTime @default(now())

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images  PublicImage[]

  @@index([publishedAt])
  @@index([versionAt])
  @@index([ownerId])
}

/// A copy of a reference image the owner chose to publish (separate files
/// under <UPLOAD_DIR>/public/, so private image URLs stay private).
model PublicImage {
  id            String  @id @default(cuid())
  publicationId String
  /// Private ReferenceImage it was copied from (owner side only; never in public responses)
  sourceImageId String?
  /// Paths relative to <UPLOAD_DIR>/public
  filePath      String
  thumbPath     String
  caption       String?
  position      Int

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([publicationId])
}

/// Admin removals of Community publications (the owner sees the reason).
model ModerationAction {
  id               String   @id @default(cuid())
  /// The owner's project (kept private and untouched)
  projectId        String
  ownerId          String
  adminId          String
  publicationTitle String
  reason           String
  createdAt        DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

/// Every event shown in Events: the built-in list (src/lib/events/builtin.ts,
/// kept in sync automatically), events added by an admin, suggested by users,
/// or found by the daily check (organisers' Instagram, event listings). Only
/// "approved" ones are shown; the rest wait in the admin's review queue.
model Event {
  id             String     @id @default(cuid())
  name           String
  /// Calendar days (UTC midnight). The year and "past" are derived from these.
  startDate      DateTime
  endDate        DateTime?
  /// Free text, e.g. "10h–19h"
  time           String?
  city           String
  country        String     @default("Portugal")
  /// Venue as the organiser names it, e.g. "ESPAV – Escola Secundária Padre António Vieira"
  venue          String?
  address        String?
  /// Optional exact map link (overrides the venue search)
  mapUrl         String?
  url            String?
  /// Ticket information as announced ("Entrada livre", "5 €"…)
  tickets        String?
  notes          String?
  /// convention | market | gaming | workshop | other
  eventType      String     @default("other")
  /// announced | tickets | confirmed | cancelled (how firm the date is)
  announceStatus String     @default("announced")
  /// Review: approved | needs_review | rejected (rejected = hidden, and never re-added)
  status         String     @default("approved")
  /// builtin | admin | user | sync | instagram
  source         String     @default("admin")
  /// Provenance: where it was found and when
  sourceUrl      String?
  capturedAt     DateTime?
  /// Poster/post image URL from the source (shown to admins while reviewing; may expire)
  posterUrl      String?
  /// Identity in the source ("builtin:<key>", "viralagenda:<id>", "instagram:<postId>"…)
  externalKey    String?    @unique
  /// Built-in events: fingerprint of the built-in data last applied
  builtinHash    String?
  /// Set when an admin edits it, so automatic refreshes don't overwrite their changes
  editedAt       DateTime?
  /// JSON of changed fields reported by the source, waiting for the admin
  pendingChange  String?
  organiserId    String?
  /// Admin who added it, or the user who suggested it
  createdBy      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organiser Organiser? @relation(fields: [organiserId], references: [id], onDelete: SetNull)

  @@index([status, startDate])
}

/// Recurring events and their organisers (e.g. Quimera Art Market). The daily
/// check reads their Instagram posts (Instagram API) for new dates; while no
/// upcoming edition is known they're listed as "next edition not announced".
model Organiser {
  id            String    @id @default(cuid())
  name          String
  /// Instagram username (business/creator account), without @
  instagram     String?   @unique
  website       String?
  city          String?
  usualVenue    String?
  usualAddress  String?
  eventType     String    @default("other")
  /// Checked daily and listed under "next edition not announced"
  active        Boolean   @default(true)
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  events Event[]
}
