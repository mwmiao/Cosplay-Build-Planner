# Example settings. Copy to .env next to docker-compose.yml and change what you need.
# Never put real passwords or codes in this example file — it is public on GitHub.

# --- Accounts ---------------------------------------------------------------
# Address you open the app at. Use the HTTPS Tailscale address (tailscale serve),
# e.g. https://nas.your-tailnet.ts.net — reset links use it, and https makes
# login cookies Secure.
APP_URL=https://nas.example-tailnet.ts.net
# Optional. If empty, a secret is generated once into data/secrets/auth-secret
# and reused across container updates. Set it (32+ chars) to manage it yourself.
AUTH_SECRET=
# Optional override of the Secure cookie flag (default: true when APP_URL is https).
COOKIE_SECURE=

# --- Email (optional: password-reset links) -----------------------------------
# Without SMTP, "Forgot password" says it's unavailable; reset passwords with:
#   docker exec cosplay-planner node scripts/reset-password.js --email user@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true for port 465 (implicit TLS); default decides from the port
SMTP_SECURE=
EMAIL_FROM=Cosplay Planner <cosplay@example.com>

# --- General ----------------------------------------------------------------
# Time zone used for "days left"
TZ=Europe/London
# Starting default currency for new accounts (each user can change theirs in Settings)
DEFAULT_CURRENCY=EUR
# Maximum size of one uploaded image, in megabytes
MAX_UPLOAD_MB=15
# Folder that holds the database, uploads, backups and secrets (default: ./data
# next to docker-compose.yml)
# DATA_PATH=./data
# Owner of the files in the data folder (run `id` on the NAS)
# PUID=1000
# PGID=1000

# --- Local development only -------------------------------------------------
# Relative to prisma/schema.prisma. Docker always uses file:/app/data/cosplay.db
DATABASE_URL=file:./dev.db
# Docker always uses /app/data/uploads
UPLOAD_DIR=./data/uploads

# Optional: Instagram API for the Events tab (organisers' business/creator accounts).
# See README → Events → Instagram. Keep the token secret.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
