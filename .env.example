# --- Required -------------------------------------------------------------
# Password for the single login. Use something long.
APP_PASSWORD=change-me-to-a-long-password
# Random secret used to sign the login cookie (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-random-hex-characters-0000000000000000000000000000

# --- Database and files -----------------------------------------------------
# Local dev: relative to prisma/schema.prisma. Docker uses file:/app/data/cosplay.db
DATABASE_URL=file:./dev.db
# Local dev default is ./data/uploads. Docker uses /app/data/uploads
UPLOAD_DIR=./data/uploads
# Maximum size of one uploaded image, in megabytes
MAX_UPLOAD_MB=15

# --- Optional ---------------------------------------------------------------
# Set to true only when the app is served over HTTPS (e.g. tailscale serve).
# Over plain http:// browsers drop secure cookies and login would loop.
COOKIE_SECURE=false
# Time zone used for "days remaining"
TZ=Europe/London
