# All settings are optional. On the NAS you don't need a .env file at all;
# create one next to docker-compose.yml only to change a default below.
# Don't put real passwords in this example file — it is public on GitHub.

# --- General ----------------------------------------------------------------
# Time zone used for "days left" (default Europe/London)
TZ=Europe/London
# Starting default currency (Settings → Currency overrides it)
DEFAULT_CURRENCY=EUR
# Maximum size of one uploaded image, in megabytes
MAX_UPLOAD_MB=15
# Folder that holds the database, uploads and backups (default: ./data next to
# docker-compose.yml). Only change it to keep data somewhere else.
# DATA_PATH=./data
# Owner of the files in the data folder (run `id` on the NAS)
# PUID=1000
# PGID=1000

# --- Local development only -------------------------------------------------
# Relative to prisma/schema.prisma. Docker always uses file:/app/data/cosplay.db
DATABASE_URL=file:./dev.db
# Docker always uses /app/data/uploads
UPLOAD_DIR=./data/uploads

# --- Optional login (off by default) ----------------------------------------
# Leave APP_PASSWORD empty for no login. To require one, set both:
APP_PASSWORD=
# Random secret, 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# true only when served over HTTPS (e.g. tailscale serve)
COOKIE_SECURE=false
